# Compileo API Dockerfile - Multi-stage build with Cython compilation
# Supports both development (dev) and production (production) targets
#
# Build development image:
#   docker build --target dev -t compileo/api:dev -f Dockerfile.api .
#
# Build production image (with Cython compilation):
#   docker build --target production -t compileo/api:prod -f Dockerfile.api .

# =============================================================================
# Stage 1: Base Builder
# =============================================================================
FROM nvidia/cuda:13.1.0-devel-ubuntu24.04 AS builder-base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install Python and system dependencies for building
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3-pip \
    build-essential \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    curl \
    git \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libgomp1 \
    libgthread-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
COPY pyproject.toml .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel Cython --break-system-packages --ignore-installed && \
    pip install --no-cache-dir -r requirements.txt --break-system-packages --ignore-installed && \
    pip install --no-cache-dir --no-build-isolation flash-attn --break-system-packages --ignore-installed

# Copy source code
COPY src/ ./src/
COPY main.py .
COPY build_cython.py .
COPY cleanup.py .

# =============================================================================
# Stage 2: Development Build (no compilation)
# =============================================================================
FROM nvidia/cuda:13.1.0-runtime-ubuntu24.04 AS dev

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH=/app

# Install Python and runtime dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1001 compileo && \
    mkdir -p storage plugins && \
    chown -R compileo:compileo /app

ENV PATH="/home/compileo/.local/bin:${PATH}"

# Copy Python packages from builder
COPY --from=builder-base /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/dist-packages
COPY --from=builder-base /usr/local/bin /usr/local/bin

# Copy source code (uncompiled for development)
COPY --chown=compileo:compileo --from=builder-base /app/src ./src
COPY --chown=compileo:compileo --from=builder-base /app/main.py .
COPY --chown=compileo:compileo pyproject.toml .

USER compileo

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

CMD ["uvicorn", "src.compileo.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# =============================================================================
# Stage 3: Production Build (with Cython compilation)
# =============================================================================
FROM builder-base AS compiler

# Re-copy build scripts to ensure Docker detects changes
COPY build_cython.py .
COPY cleanup.py .

# Run Cython compilation (use python3 explicitly)
# Build and cleanup in one step - use environment variable to skip confirmation
RUN python3 build_cython.py --clean && \
    echo "CLEANUP" | python3 cleanup.py --skip-build-cleanup

# =============================================================================
# Stage 4: Production Runtime
# =============================================================================
FROM nvidia/cuda:13.1.0-runtime-ubuntu24.04 AS production

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH=/app \
    COMPILEO_ENVIRONMENT=production

# Install Python and runtime dependencies only (no build tools)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1001 compileo && \
    mkdir -p storage plugins && \
    chown -R compileo:compileo /app

ENV PATH="/home/compileo/.local/bin:${PATH}"

# Copy Python packages from builder
COPY --from=builder-base /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/dist-packages
COPY --from=builder-base /usr/local/bin /usr/local/bin

# Copy compiled application code (source removed, .so files only)
COPY --chown=compileo:compileo --from=compiler /app/src ./src
COPY --chown=compileo:compileo --from=compiler /app/main.py .
COPY --chown=compileo:compileo pyproject.toml .

# Verify compiled modules are present (using src.compileo path)
RUN python3 -c "import src.compileo.storage.src.database; print('✓ Database module loaded')" && \
    python3 -c "import src.compileo.core.settings; print('✓ Settings module loaded')"

USER compileo

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Production command without reload
CMD ["uvicorn", "src.compileo.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]