# Compileo Docker Configuration
# Copy this file to .env and customize the values

# ==========================================
# JWT AUTHENTICATION (Multi-Tenant)
# ==========================================
# JWT Secret Key for token signing (REQUIRED - CHANGE IN PRODUCTION!)
# This is used for multi-tenant user authentication
COMPILEO_JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# JWT Token expiration in minutes (optional, default: 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# WORKER CONFIGURATION (Production)
# ==========================================
# Number of worker replicas to run for parallel job processing
# More replicas = more concurrent jobs but higher resource usage
WORKER_REPLICAS=2

# Worker concurrency - number of concurrent jobs per worker
# This controls how many jobs each worker processes simultaneously
WORKER_CONCURRENCY=2

# ==========================================
# LICENSE CONFIGURATION (Optional - SaaS)
# ==========================================
# Uncomment and set these if using license enforcement for SaaS
# COMPILEO_LICENSE_KEY=your-license-key-here
# COMPILEO_LICENSE_SERVER=https://license.compileo.example.com

# ==========================================
# STORAGE MOUNT CONFIGURATION
# ==========================================
# Path to mount the storage volume (contains database, uploads, etc.)
# This should match the volume mount in docker-compose.yml
COMPILEO_STORAGE_PATH=./storage

# ==========================================
# OPTIONAL: ADVANCED SETTINGS
# ==========================================
# Uncomment and modify these only if needed

# Redis URL (if using external Redis)
# REDIS_URL=redis://redis:6379/0

# CORS Origins (comma-separated list of allowed origins)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# Logging Level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# ==========================================
# DEPRECATED (Do Not Use)
# ==========================================
# API_KEY has been deprecated in favor of JWT for multi-tenant support
# API_KEY=default-api-key
